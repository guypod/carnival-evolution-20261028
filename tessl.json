{
  "name": "ws-01a163fa71c4754eb74e01d925aab797/carnival-factory-lab-20261022",
  "mode": "vendored",
  "dependencies": {},
  "actions": {
    "implement-github-issue": {
      "skill": "tessl-labs/factory@0.6.0#implement-github-issue",
      "environment": "carnival-factory-lab-20261022-factory",
      "agent": "claude-code",
      "model": "claude-opus-5-5",
      "timeout": "15m",
      "instructions": "Keep all published skill invariants and fresh-read requirements. After the final source change, base merge and final commit, run npm run factory:verify, then npm run factory:verify -- --validate before reporting completion. Cite the exact current Git HEAD and the recorded npm run check and npm run build exit codes/outcomes. If HEAD or source changes, rerun verification; report failures and timeouts honestly rather than claiming success. The ignored local receipt is mutable evidence, not an attestation, a substitute for required CI/review, or authorization to push, mark ready or merge."
    },
    "shepherd": {
      "skill": "tessl-labs/factory@0.6.0#shepherd",
      "environment": "carnival-factory-lab-20261022-factory",
      "agent": "claude-code",
      "model": "claude-opus-5-5",
      "timeout": "10m",
      "instructions": "Keep all published skill invariants and fresh-read requirements. After the final source change, base merge and final commit, run npm run factory:verify, then npm run factory:verify -- --validate before reporting completion. Cite the exact current Git HEAD and the recorded npm run check and npm run build exit codes/outcomes. If HEAD or source changes, rerun verification; report failures and timeouts honestly rather than claiming success. The ignored local receipt is mutable evidence, not an attestation, a substitute for required CI/review, or authorization to push, mark ready or merge."
    },
    "follow-ticket-changes": {
      "skill": "tessl-labs/factory@0.6.0#follow-ticket-changes",
      "environment": "carnival-factory-lab-20261022-factory",
      "agent": "claude-code",
      "model": "claude-opus-5-5",
      "timeout": "5m"
    }
  },
  "triggers": {
    "github-issue-labelled": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.type": "User",
        "event.sender.id": 1106394,
        "event.issue.state": "open",
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "implement-github-issue"
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1430175635,
        "event.pull_request.state": "open",
        "event.sender.id": 1106394,
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1430175635,
        "event.pull_request.state": "open",
        "event.sender.id": 1106394,
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.issue.state": "open",
        "event.sender.id": 1106394,
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-failed": {
      "on": [
        "github:check_run.completed"
      ],
      "when": {
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.pull_requests.0.head.repo.id": 1430175635,
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_run.conclusion": {
          "in": [
            "failure",
            "timed_out",
            "startup_failure",
            "action_required"
          ]
        },
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_run.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-passed": {
      "on": [
        "github:check_suite.completed"
      ],
      "when": {
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        },
        "event.check_suite.pull_requests.0.head.repo.id": 1430175635,
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.conclusion": "success",
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_suite.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-review-by-reviewer": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1430175635,
        "event.pull_request.state": "open",
        "event.sender.id": 325629464,
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.sender.id": 1106394,
        "event.pull_request.head.repo.id": 1430175635,
        "event.repository.id": 1430175635,
        "event.pull_request.state": "closed"
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed"
        }
      }
    },
    "follow-ticket-changes-github-taken-back": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": 1106394,
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back"
        }
      }
    },
    "follow-ticket-changes-github-ended": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": 1106394,
        "event.repository.id": 1430175635,
        "event.issue.state": "closed"
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended"
        }
      }
    },
    "follow-ticket-changes-github-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": 1106394,
        "event.repository.id": 1430175635
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied"
        }
      }
    }
  }
}
